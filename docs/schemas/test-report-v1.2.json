{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness test report (v1.2)",
  "description": "Structured capture of a single pytest run emitted by admiral-reporter (PRD-007 v1.2, with Stage scenario timeline capture per PRD-013). Additive over v1.1: schema_version bumps from '1.1' to '1.2'; timeline_entry.topic relaxed to optional (omitted for scope-level events such as DEADLINE, see PRD-013 §D-3); new optional timeline_entry.transport with regex pattern; new optional timeline_entry.logical_topic for cross-transport bridge translation. Single-Harness entries continue to omit the new optional fields entirely (byte-identity preserved per PRD-012 §1.5). Reply state enum is unchanged.",
  "type": "object",
  "required": ["schema_version", "run", "tests"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "description": "Major.Minor version. Consumers gate on the Major component (consumers gating on `schema_version.startswith(\"1\")` continue to work across v1.0, v1.1, and v1.2). Strict-validator consumers pin a specific Major.Minor.",
      "const": "1.2"
    },
    "run": { "$ref": "#/$defs/run" },
    "tests": {
      "type": "array",
      "items": { "$ref": "#/$defs/test" }
    }
  },

  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "finished_at",
        "duration_ms",
        "totals",
        "project_name",
        "allowlist_path",
        "python_version",
        "harness_version",
        "reporter_version",
        "git_sha",
        "git_branch",
        "environment",
        "hostname",
        "xdist",
        "truncated",
        "redactions"
      ],
      "anyOf": [
        { "required": ["transport"] },
        { "required": ["transports"] }
      ],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "number", "minimum": 0 },
        "totals": { "$ref": "#/$defs/totals" },
        "project_name": { "type": ["string", "null"] },
        "transport": {
          "description": "Single-Harness transport class name (e.g. 'MockTransport', 'NatsTransport'). Null for runs containing any Stage scenario; in mixed-mode runs, the value is null and `transports` carries the union.",
          "type": ["string", "null"]
        },
        "transports": {
          "description": "Union of every transport name encountered in the run, sorted alphabetically. Present for any run containing a Stage scenario; absent for single-Harness-only runs.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          }
        },
        "allowlist_path": { "type": ["string", "null"] },
        "python_version": { "type": "string" },
        "harness_version": { "type": "string" },
        "reporter_version": { "type": "string" },
        "git_sha": { "type": ["string", "null"] },
        "git_branch": { "type": ["string", "null"] },
        "environment": { "type": ["string", "null"] },
        "hostname": { "type": "string" },
        "xdist": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["workers", "incomplete_workers"],
              "properties": {
                "workers": { "type": "integer", "minimum": 1 },
                "incomplete_workers": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          ]
        },
        "truncated": { "type": "boolean" },
        "redactions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fields", "stream_matches"],
          "properties": {
            "fields": { "type": "integer", "minimum": 0 },
            "stream_matches": { "type": "integer", "minimum": 0 },
            "redaction_version": {
              "description": "Algorithm version emitted by admiral.redaction.redact_wire_id. Bumps if the algorithm tightens. Absent for v1.0-style reports that did not emit hash-redacted wire ids.",
              "type": "string",
              "pattern": "^v[0-9]+$"
            }
          }
        }
      }
    },

    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "errored", "skipped", "slow", "total"],
      "properties": {
        "passed":   { "type": "integer", "minimum": 0 },
        "failed":   { "type": "integer", "minimum": 0 },
        "errored":  { "type": "integer", "minimum": 0 },
        "skipped":  { "type": "integer", "minimum": 0 },
        "slow":     { "type": "integer", "minimum": 0 },
        "total":    { "type": "integer", "minimum": 0 }
      }
    },

    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeid",
        "file",
        "name",
        "class",
        "markers",
        "admiral_meta",
        "outcome",
        "duration_ms",
        "traceback",
        "stdout",
        "stderr",
        "log",
        "skip_reason",
        "worker_id",
        "scenarios"
      ],
      "properties": {
        "nodeid":       { "type": "string" },
        "file":         { "type": "string" },
        "name":         { "type": "string" },
        "class":        { "type": ["string", "null"] },
        "markers":      { "type": "array", "items": { "type": "string" } },
        "admiral_meta":  {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "timeout_ms": { "type": "number", "minimum": 0 },
                "tags":       { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            }
          ]
        },
        "outcome":      { "enum": ["passed", "failed", "errored", "skipped", "slow"] },
        "duration_ms":  { "type": "number", "minimum": 0 },
        "traceback":    { "type": ["string", "null"] },
        "stdout":       { "type": "string" },
        "stderr":       { "type": "string" },
        "log":          { "type": "string" },
        "skip_reason":  { "type": ["string", "null"] },
        "worker_id":    { "type": ["string", "null"] },
        "scenarios":    { "type": "array", "items": { "$ref": "#/$defs/scenario" } }
      }
    },

    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "correlation_id",
        "outcome",
        "duration_ms",
        "completed_normally",
        "handles",
        "timeline",
        "timeline_dropped",
        "replies",
        "summary_text"
      ],
      "properties": {
        "name":               { "type": "string" },
        "correlation_id":     { "type": ["string", "null"] },
        "outcome":            { "enum": ["pass", "fail", "timeout", "slow"] },
        "duration_ms":        { "type": "number", "minimum": 0 },
        "completed_normally": { "type": "boolean" },
        "handles":            { "type": "array", "items": { "$ref": "#/$defs/handle" } },
        "timeline":           { "type": "array", "items": { "$ref": "#/$defs/timeline_entry" } },
        "timeline_dropped":   { "type": "integer", "minimum": 0 },
        "replies":            { "type": "array", "items": { "$ref": "#/$defs/reply_report" } },
        "summary_text":       { "type": "string" },
        "stage": {
          "description": "Per-scenario Stage block. Presence is the canonical signal that this scenario was a multi-transport Stage scenario (PRD-012 US-3). Absent for single-Harness scenarios.",
          "type": "object",
          "additionalProperties": false,
          "required": ["bridge_class", "transports", "correlation_ids"],
          "properties": {
            "bridge_class": {
              "description": "Class name of the CorrelationBridge in effect. Advisory-tier field per PRD-012 §3.6: useful for debugging, NOT a stable contract; consumers naming a bridge class for clarity may rename it across releases. Pattern restricts to safe identifier characters.",
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$"
            },
            "transports": {
              "description": "Transport names registered on the Stage, sorted alphabetically (deterministic; snapshot-test friendly).",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              }
            },
            "correlation_ids": {
              "description": "Map of transport name to the per-transport correlation id stamped onto outbound messages by the bridge. Keys mirror the `transports` array (transport names; same regex). Values are HASH-REDACTED via `admiral.redaction.redact_correlation_id` (SHA-256 truncated to 16 hex chars, prefixed `sha256:`). Each Stage handle's `correlation_id` field carries the same redacted form for its transport.",
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{16}$"
              }
            }
          }
        }
      }
    },

    "reply_report": {
      "description": "PRD-008 / ADR-0017 reply report. Terminal state of a scope-bound reply. `builder_error` is the exception class name only (ADR-0017 §Security); `matcher_description` is redacted before serialisation. PRD-012 adds optional `trigger_transport` and `response_transport` for Stage replies; the framework's StageReplyState.FIRED maps to 'replied' and FIRED_BUILDER_ERROR maps to 'reply_failed' (no enum extension).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_topic",
        "reply_topic",
        "state",
        "matcher_description",
        "candidate_count",
        "match_count",
        "reply_published",
        "builder_error",
        "correlation_overridden"
      ],
      "properties": {
        "trigger_topic":          { "type": "string" },
        "reply_topic":            { "type": "string" },
        "state":                  { "enum": ["armed_no_match", "armed_matcher_mismatched", "replied", "reply_failed"] },
        "matcher_description":    { "type": "string" },
        "candidate_count":        { "type": "integer", "minimum": 0 },
        "match_count":            { "type": "integer", "minimum": 0 },
        "reply_published":        { "type": "boolean" },
        "builder_error":          { "type": ["string", "null"] },
        "correlation_overridden": { "type": "boolean" },
        "trigger_transport": {
          "description": "Transport on which the trigger fired (Stage replies only). Absent or null for single-Harness replies.",
          "type": ["string", "null"]
        },
        "response_transport": {
          "description": "Transport on which the response published (Stage replies only). Absent or null for single-Harness replies.",
          "type": ["string", "null"]
        }
      }
    },

    "handle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "outcome",
        "latency_ms",
        "budget_ms",
        "matcher_description",
        "expected",
        "actual",
        "attempts",
        "reason",
        "truncated",
        "failure",
        "failures",
        "failures_dropped",
        "diagnosis"
      ],
      "properties": {
        "topic":               { "type": "string" },
        "outcome":             { "enum": ["pass", "fail", "timeout", "slow", "pending"] },
        "latency_ms":          { "type": ["number", "null"], "minimum": 0 },
        "budget_ms":           { "type": ["number", "null"], "minimum": 0 },
        "matcher_description": { "type": "string" },
        "expected":            {},
        "actual":              {},
        "attempts":            { "type": "integer", "minimum": 0 },
        "reason":              { "type": "string" },
        "truncated":           { "type": "boolean" },

        "failure": {
          "description": "Structured reason for a FAIL handle; null for other outcomes. Step 5 makes this the sole failure carrier; `reason` remains in v1 for transition.",
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/match_failure" }
          ]
        },
        "failures": {
          "description": "Every near-miss observed on this handle, oldest-first, bounded.",
          "type": "array",
          "items": { "$ref": "#/$defs/match_failure" }
        },
        "failures_dropped": {
          "description": "Count of near-misses beyond the retention cap.",
          "type": "integer",
          "minimum": 0
        },
        "diagnosis": {
          "description": "Typed classification of the handle's outcome so the report UI composes prose from fields, not strings.",
          "$ref": "#/$defs/handle_diagnosis"
        },
        "transport": {
          "description": "Transport name for handles produced by Stage scenarios; absent for single-Harness handles. Mirrors Handle.transport in code.",
          "type": ["string", "null"]
        },
        "correlation_id": {
          "description": "Hash-redacted per-handle wire id for Stage handles (PRD-012 §1.5.1, §2.3); absent for single-Harness handles. Form: 'sha256:<16 hex chars>'.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{16}$"
        }
      }
    },

    "match_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "expected"],
      "properties": {
        "kind": { "enum": ["missing", "mismatch", "type_mismatch", "predicate", "composed"] },
        "path": { "type": "string" },
        "expected": {},
        "actual": {},
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/match_failure" }
        }
      }
    },

    "handle_diagnosis": {
      "description": "Discriminated by `kind`. The UI composes any prose from these fields; the framework never emits English here.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "matched" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "latency_ms", "budget_ms"],
          "properties": {
            "kind": { "const": "over_budget" },
            "latency_ms": { "type": "number", "minimum": 0 },
            "budget_ms":  { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "attempts", "deadline_ms"],
          "properties": {
            "kind": { "const": "near_miss" },
            "attempts":    { "type": "integer", "minimum": 1 },
            "deadline_ms": { "type": "number",  "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "topic", "deadline_ms"],
          "properties": {
            "kind": { "const": "silent_timeout" },
            "topic":       { "type": "string" },
            "deadline_ms": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "pending" } }
        }
      ]
    },

    "timeline_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset_ms", "wall_clock", "action", "detail"],
      "properties": {
        "offset_ms":     { "type": "number" },
        "wall_clock":    { "type": "string", "format": "date-time" },
        "topic":         { "type": "string", "description": "Wire topic the event observed. OMITTED for scope-level events (currently only DEADLINE) per PRD-013 §D-3." },
        "action":        { "enum": ["published", "received", "matched", "mismatched", "deadline", "correlation_skipped", "replied", "reply_failed"] },
        "detail":        { "type": "string" },
        "transport":     { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$", "description": "Per-transport attribution for Stage scenarios (PRD-013 §1.1). OMITTED for single-Harness entries (PRD-012 byte-identity) and for scope-level Stage events." },
        "logical_topic": { "type": "string", "description": "Pre-bridge-translation topic name where it differs from the wire topic. Forward-compat for translating bridges; OMITTED today's MappedBridge does not translate topics." }
      }
    }
  }
}
